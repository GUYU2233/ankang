# 数据库：本地开发默认 SQLite；Docker 部署时使用 MySQL
DATABASE_URL=sqlite:///./zhihu_ankang.db
AI_ENGINE_URL=http://127.0.0.1:8100
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 萤石开放平台（真机联调时填写）
EZVIZ_APP_KEY=
EZVIZ_APP_SECRET=

# 检测节奏（秒）
DETECT_INTERVAL_SECONDS=2.0
ALERT_CONFIRM_FRAMES=2

# 多模态视觉巡检（定时截图 + 大模型识别；enabled=false 时不运行）
# provider: qwen / glm / gpt / gemini / custom（custom 需自定义 base_url & model）
MULTIMODAL_ENABLED=false
MULTIMODAL_PROVIDER=qwen
MULTIMODAL_MODEL=
MULTIMODAL_BASE_URL=
MULTIMODAL_API_KEY=
MULTIMODAL_INTERVAL_SECONDS=60
MULTIMODAL_TEMPERATURE=0.2
MULTIMODAL_MAX_TOKENS=800
MULTIMODAL_TIMEOUT_SECONDS=30.0